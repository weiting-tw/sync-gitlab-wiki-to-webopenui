# 複製成 .env 後填入實際值: cp .env.example .env
# 載入方式 (擇一):
#   set -a; source .env; set +a    # bash/zsh
#   或用 python-dotenv / direnv

# GitLab Wiki repo 網址 (注意是 .wiki.git 結尾)
GITLAB_WIKI_URL=https://gitlab.example.com/group/project.wiki.git

# 具 read_repository 權限的 PAT / Project Access Token
GITLAB_TOKEN=glpat-xxxxxxxxxxxxxxxxxxxx

# Open WebUI 服務網址
OWUI_URL=http://localhost:3000

# Open WebUI API key (Settings > Account)，需為知識庫擁有者的 key
OWUI_TOKEN=sk-xxxxxxxxxxxxxxxxxxxx

# 目標知識庫 ID
OWUI_KNOWLEDGE_ID=00000000-0000-0000-0000-000000000000

# 暫存目錄 (選填，預設 /tmp/wiki-sync)
WORKDIR=/tmp/wiki-sync

# 同步模式 (選填):
#   incremental (預設) 以線上 file_hash 對帳,只同步變更檔
#   full        reset 清空後重傳全部
SYNC_MODE=incremental
